<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Macula</PackageId>
    <RootNamespace>Macula</RootNamespace>
    <AssemblyName>Macula</AssemblyName>
    <Version>0.1.1</Version>
    <Description>Native C# client for the Macula mesh wire protocol -- QUIC transport, deterministic CBOR, Ed25519 identity, unary RPC, PubSub, content transfer, and streaming RPC (both caller and provider roles). No FFI, no native protocol library.</Description>
    <Authors>Macula</Authors>
    <PackageLicenseExpression>Apache-2.0 OR MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/macula-io/macula-csharp-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/macula-io/macula-csharp-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>macula;mesh;quic;rpc;pubsub;wire-protocol</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blake3" Version="3.0.2" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.5.1" />
    <PackageReference Include="Unofficial.MsQuic" Version="2.4.10" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Macula.Tests" />
  </ItemGroup>

</Project>
