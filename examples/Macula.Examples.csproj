<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\src\Macula\Macula.Client.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- These examples only ever run on the platforms QUIC itself
         supports (linux/macos/windows); CA1416 flags every call into the
         library's QUIC-gated API surface as "not supported everywhere,"
         which is accurate but not actionable here. -->
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

</Project>
